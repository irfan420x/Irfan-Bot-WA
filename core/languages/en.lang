# handlerEvents — system messages (mirrors Messenger bot, WhatsApp-applicable keys only)
handlerEvents.commandNotFound=Command "%1" does not exist, type %2help to see all available commands
handlerEvents.commandNotFound2=Hey! %1, prefix alone does nothing, please type %2help to see what I can do and explore all available commands
handlerEvents.commandSyntaxError=The command you are using is wrong syntax, please type %1help %2 to see the details of how to use this command
handlerEvents.onlyAdmin=❌ | Hey, %1 — only group administrators can use the "%2" command
handlerEvents.onlyAdminBot2=❌ | Hey, %1 — only the bot admin can use the "%2" command
handlerEvents.onlyCreator=❌ | Hey, %1 — only the bot creator can use the "%2" command
handlerEvents.waitingForCommand=⏱ You are in the waiting time to use this command, please come back after %1s
handlerEvents.errorOccurred=❌ [ %1 ]\nAn error occurred at command "%2"\n\n%3
handlerEvents.cannotFindCommandName=❌ Cannot find command name to execute this reply!
handlerEvents.cannotFindCommand=❌ Cannot find command "%1" to execute this reply!
# wabot — WhatsApp handler system messages (currently hardcoded in core/handler/handlerMessage.js)
wabot.onlyBotAdmin=This command is for bot admins only.
wabot.onlyGroup=This command only works in groups.
wabot.onlyGroupAdmin=This command is for group admins only.
wabot.cooldown=Slow down — wait %1s before using %2 again.
wabot.commandError=Something went wrong while running that command.
